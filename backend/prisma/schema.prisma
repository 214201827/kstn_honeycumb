generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  names     String
  lastName  String?
  role      UserRole @default(STAFF)
  provider  String?  // e.g. "local" or "google"
  googleId  String?  @unique
  tenantId  String?  
  emailVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // relations
  credentials StudentCredential[] @relation("printedBy")
  tenant     Tenant? @relation(fields: [tenantId], references: [id])
}

enum UserRole {
  ADMIN
  COORDINATOR
  TEACHER
  STAFF
  FAMILY
}

model Student {
  id           String   @id @default(uuid())
  names        String
  lastNames    String
  email        String?  @unique
  dateOfBirth  DateTime?
  gender       String?
  phone        String?
  photoUrl     String?
  enrollmentAt DateTime?
  status       StudentStatus @default(ACTIVE)
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // relations
  credentials  StudentCredential[]
  grades       StudentGrade[]
  attendance   Attendance[]
  tenant       Tenant? @relation(fields: [tenantId], references: [id])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  ON_LEAVE
}

model StudentCredential {
  id               String   @id @default(uuid())
  studentId        String
  credentialNumber String   @unique
  issueDate        DateTime
  expiryDate       DateTime
  qrSignature      String?
  qrUrl            String?
  isActive         Boolean  @default(true)
  printedById      String?
  printedAt        DateTime?

  student Student @relation(fields: [studentId], references: [id])
  printedBy User?  @relation("printedBy", fields: [printedById], references: [id])
}

model Course {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  students  Student[]
  courses   Course[]
}

enum ActivitySource {
  CLASSROOM
  MANUAL
}

model Activity {
  id         String   @id @default(uuid())
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   String
  title      String
  description String?
  dueDate    DateTime?
  weight     Float?
  maxScore   Float?   @default(100)
  source     ActivitySource @default(MANUAL)
  externalId String?  // id from Classroom when applicable
  rubric     Json?
  attachments String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ImportJob {
  id        String   @id @default(uuid())
  tenantId  String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status    String
  details   Json?

  tenant    Tenant? @relation(fields: [tenantId], references: [id])
}

model AcademicPeriod {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
}

model StudentGrade {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  period    AcademicPeriod @relation(fields: [periodId], references: [id])
  periodId  String
  grade     Float
  comments  String?
  gradedBy  String?
  gradedAt  DateTime @default(now())
}

model Attendance {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  date      DateTime
  status    AttendanceStatus
  notes     String?
  recordedBy String?
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
